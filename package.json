{
  "name": "website",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate-env": "node scripts/env.js",
    "dev": "ng serve --open",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:website": "node dist/website/server/server.mjs",
    "lint": "ng lint --fix",
    "format": "prettier \"src/**/*.{ts,html,scss,json,md}\" --write",
    "postinstall": "npm run generate-env",
    "colors:fallback": "node scripts/colors-fallback.js",
    "colors:fallback:dark": "node scripts/colors-fallback.js --dark",
    "colors:fallback:force": "node scripts/colors-fallback.js --force",
    "colors:fallback:dark:force": "node scripts/colors-fallback.js --dark --force"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.2",
    "@angular/cdk": "22.0.2",
    "@angular/common": "^22.0.2",
    "@angular/compiler": "^22.0.2",
    "@angular/core": "^22.0.2",
    "@angular/forms": "^22.0.2",
    "@angular/material": "22.0.2",
    "@angular/platform-browser": "^22.0.2",
    "@angular/platform-browser-dynamic": "^22.0.2",
    "@angular/platform-server": "^22.0.2",
    "@angular/router": "^22.0.2",
    "@angular/ssr": "^22.0.3",
    "@netlify/angular-runtime": "^4.0.0",
    "@zip.js/zip.js": "^2.8.26",
    "class-variance-authority": "^0.7.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ng-qrcode": "^21.0.0",
    "rxjs": "~7.8.2",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.0.0",
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^25.9.3",
    "angular-eslint": "22.0.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "postcss": "^8.5.15",
    "prettier": "3.8.4",
    "tailwindcss": "^4.3.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.61.1"
  }
}